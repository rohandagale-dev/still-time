# Copy to `.env` in the repository root. Both apps read this file.
# Real environment variables always take precedence over values in this file.

# ─── Backend (apps/backend) ─────────────────────────────────────────────────
# NODE_ENV=development   # development (default) | test | production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/stilltime

# Authentication strategy.
#   development → every request is attributed to DEV_USER_ID. Refused when NODE_ENV=production.
#   (unset)     → no strategy configured; every /api request is rejected with 401 (fail closed).
AUTH_MODE=development
DEV_USER_ID=local-dev-user

# Comma-separated CORS allow-list. `chrome-extension://*` accepts any extension origin and is
# convenient locally; pin your extension ID (chrome-extension://<id>) anywhere else.
CORS_ORIGINS=chrome-extension://*

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ─── Extension (apps/extension) — baked in at build time ───────────────────
# Base URL of the sync API. Its origin is also written to the manifest's host_permissions.
VITE_API_BASE_URL=http://localhost:4000/api
