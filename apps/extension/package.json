{
  "name": "@stilltime/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Stilltime Chrome extension (Manifest V3).",
  "type": "module",
  "scripts": {
    "dev": "tsc -b ../../packages/shared && vite build --watch --mode development",
    "build": "tsc -b ../../packages/shared && vite build",
    "typecheck": "tsc -b ../../packages/shared && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "tsc -b ../../packages/shared && vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@stilltime/shared": "*",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "mongodb-memory-server": "^11.3.0",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "../../node_modules/.cache/mongodb-memory-server"
    }
  }
}
