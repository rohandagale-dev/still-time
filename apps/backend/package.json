{
  "name": "@stilltime/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stilltime sync API — Express, Mongoose and Zod.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc -b ../../packages/shared && tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -b ../../packages/shared && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -b ../../packages/shared && tsc -p tsconfig.json",
    "test": "tsc -b ../../packages/shared && vitest run",
    "db:memory": "tsx scripts/memory-db.ts"
  },
  "dependencies": {
    "@stilltime/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "../../node_modules/.cache/mongodb-memory-server"
    }
  }
}
